rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFriendOf(ownerId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/friendships/$(ownerId)/friends/$(request.auth.uid));
    }

    function sharedEventValid() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'title',
          'date',
          'color',
          'categoryName',
          'completed',
          'groupId',
          'startMinutes',
          'endMinutes',
          'visibility',
          'updatedAt'
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.date is string &&
        data.color is int &&
        (data.visibility == 'title' || data.visibility == 'busy') &&
        data.updatedAt is int &&
        (!('categoryName' in data) || data.categoryName == null ||
          (data.categoryName is string && data.categoryName.size() <= 32)) &&
        (!('completed' in data) || data.completed is bool) &&
        (!('groupId' in data) || data.groupId == null || data.groupId is string) &&
        (!('startMinutes' in data) || data.startMinutes == null || data.startMinutes is int) &&
        (!('endMinutes' in data) || data.endMinutes == null || data.endMinutes is int);
    }

    function sharedStickerValid() {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'asset', 'updatedAt']) &&
        data.date is string &&
        data.date.size() == 10 &&
        data.asset is string &&
        data.asset.size() > 0 &&
        data.asset.size() <= 200 &&
        data.asset.matches('assets/stickers/.*') &&
        data.updatedAt is int;
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);
      match /vaults/{provider} {
        allow read, write: if isUser(userId);
      }
    }

    match /profiles/{userId} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /friend_codes/{code} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    function requestCreateOk() {
      let data = request.resource.data;
      return data.fromUid == request.auth.uid &&
        data.toUid is string &&
        data.toUid.size() > 0 &&
        data.toUid != request.auth.uid &&
        data.status == 'pending' &&
        data.fromName is string &&
        data.fromCode is string &&
        data.toName is string &&
        data.toCode is string &&
        data.createdAt is int &&
        exists(/databases/$(database)/documents/profiles/$(data.toUid));
    }

    function pendingRequest(requestId, fromId, toId) {
      return exists(/databases/$(database)/documents/friend_requests/$(requestId)) &&
        get(/databases/$(database)/documents/friend_requests/$(requestId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/friend_requests/$(requestId)).data.fromUid == fromId &&
        get(/databases/$(database)/documents/friend_requests/$(requestId)).data.toUid == toId;
    }

    match /friend_requests/{requestId} {
      allow get: if signedIn() &&
        (resource == null ||
         resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid ||
         request.auth.uid in resource.data.participants);
      allow list: if signedIn() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid ||
         request.auth.uid in resource.data.participants);
      allow create: if signedIn() && requestCreateOk();
      allow update: if signedIn() &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        (
          (
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']) &&
            (
              (resource.data.toUid == request.auth.uid &&
                (request.resource.data.status == 'accepted' ||
                 request.resource.data.status == 'declined')) ||
              (resource.data.fromUid == request.auth.uid &&
                request.resource.data.status == 'cancelled')
            )
          ) ||
          (
            resource.data.fromUid == request.auth.uid &&
            resource.data.status != 'pending' &&
            requestCreateOk()
          )
        );
      allow delete: if false;
    }

    match /friendships/{userId}/friends/{friendId} {
      allow read: if isUser(userId) || isUser(friendId);
      allow create: if signedIn() &&
        userId != friendId &&
        request.resource.data.requestId is string &&
        (
          (isUser(userId) &&
            pendingRequest(request.resource.data.requestId, friendId, request.auth.uid)) ||
          (isUser(friendId) &&
            pendingRequest(request.resource.data.requestId, userId, request.auth.uid))
        );
      allow update: if isUser(userId);
      allow delete: if isUser(userId) || isUser(friendId);
    }

    match /shared_calendars/{userId}/events/{eventId} {
      allow read: if isUser(userId) || isFriendOf(userId);
      allow create, update: if isUser(userId) && sharedEventValid();
      allow delete: if isUser(userId);
    }

    match /shared_calendars/{userId}/stickers/{stickerId} {
      allow read: if isUser(userId) || isFriendOf(userId);
      allow create, update: if isUser(userId) && sharedStickerValid();
      allow delete: if isUser(userId);
    }

    match /rate_limits/{id} {
      allow read, write: if false;
    }
  }
}
